target/
stdx/
build-script-cache/
dist/
*.log
.cache/

# cjpm writes a lock file even when the module has no dependencies at all. This
# library only depends on std/stdx (resolved through CANGJIE_STDX_PATH), so the
# lock would always be an empty `version = 0` stub; keep it out of the tree, both
# at the library root and in the example module.
cjpm.lock

# The fixture generator is the only Python in this repo; keep its bytecode out.
__pycache__/
*.py[cod]
