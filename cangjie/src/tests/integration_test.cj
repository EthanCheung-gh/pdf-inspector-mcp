package pdf_inspector_mcp.tests

import std.collection.*
import std.convert.*
import std.fs.*
import std.random.*
import std.time.*
import std.unittest.*
import std.unittest.testmacro.*
import stdx.encoding.json.*
import magic.core.tool.{Tool, ToolException, ToolResponse}
import pdf_inspector_mcp.export.*
import pdf_inspector_mcp.mcp.*
import pdf4cj.*

/**
 * Golden integration tests: the Cangjie engine against the Python baseline.
 *
 * The fixtures (PDF files in `tests/fixtures/`) and the goldens (JSON/CSV files
 * in `tests/goldens/`) are committed artifacts generated by `.venv/bin/python
 * cangjie/tests/generate_fixtures.py` and `generate_goldens.py`. The goldens come
 * from `pdf_inspector_mcp.extractor` / `pdf_inspector_mcp.export`, i.e. from
 * pdfplumber + the Python server, so this file is the behavioural-consistency
 * proof between the two implementations.
 *
 * Paths are relative to the project directory (`cangjie/`), which is where
 * `cjpm test` runs. To regenerate after changing a fixture:
 *
 *     .venv/bin/python cangjie/tests/generate_fixtures.py   # from the repo root
 *     .venv/bin/python cangjie/tests/generate_goldens.py
 *
 * Tolerances are the ones agreed with the planner: bboxes ±1.0 (pdfplumber's
 * glyph metrics and the Cangjie metrics tables round differently in the last
 * decimals), sizes/widths ±0.01, colour components ±0.001. Text, counts, page
 * numbers and table cells are compared exactly - a looser assertion there would
 * hide real differences instead of reporting them.
 *
 * Two known deviations are deliberately *not* asserted as equal; both are
 * reported to the planner instead of being papered over:
 *
 * 1. `rect.fill`: Python's extractor derives it from "a non-stroking colour is
 *    set" (`extractor.py: 'fill': r.get('non_stroking_color') is not None`),
 *    which is true for a stroke-only rectangle; the Cangjie engine reports the
 *    painting operator (`S` -> false, `f`/`B` -> true). The test case
 *    `rectFillFollowsThePaintingOperator` pins the Cangjie value explicitly, and
 *    the generic rect comparison below skips the field.
 * 2. Word order when the content stream draws lines in a non-reading order:
 *    pdfplumber groups words in content-stream order, the Cangjie splitter emits
 *    them by descending baseline. `quoted-table.pdf` is the only fixture that
 *    draws out of order; the word-order test case pins the Cangjie sequence, and
 *    that fixture's CSV comparison skips the word `text` column (character and
 *    table text are still compared exactly).
 */

// --- fixtures and goldens ---------------------------------------------------

let IT_FIXTURES = "tests/fixtures/"
let IT_GOLDENS = "tests/goldens/"
let IT_BOM = "\u{FEFF}"

/** Bbox tolerance: pdfplumber vs. Cangjie glyph metrics disagree below this. */
let IT_BBOX_TOLERANCE: Float64 = 1.0

/** Size/width tolerance: the two font-metric tables round differently. */
let IT_SIZE_TOLERANCE: Float64 = 0.01

/** Colour component tolerance. */
let IT_COLOR_TOLERANCE: Float64 = 0.001

func itFixture(name: String): String {
    return IT_FIXTURES + name + ".pdf"
}

func itReadText(path: String): String {
    return String.fromUtf8(File.readFrom(path))
}

/**
 * A temp file path unique to this run.
 *
 * A fixed `/tmp/...` name would be shared by two concurrent `cjpm test` runs
 * (and by a leftover file from an earlier run): the random 32-bit token plus
 * the sub-second nanoseconds keep every run's export file its own. Callers
 * remove the file in a `finally`.
 */
func itTempPath(label: String): String {
    let token = Random().nextUInt32().toString() + "-" + DateTime.nowUTC().nanosecond.toString()
    return "/tmp/pdf-inspector-cj-" + label + "-" + token
}

func itGoldenObject(report: ItReport, name: String, kind: String): JsonObject {
    let path = IT_GOLDENS + name + "." + kind + ".json"
    return itParseObject(report, itReadText(path), path)
}

func itGoldenText(name: String, kind: String, suffix: String): String {
    return itReadText(IT_GOLDENS + name + "." + kind + suffix)
}

func itParseObject(report: ItReport, text: String, at: String): JsonObject {
    let parsed = try {
        JsonValue.fromStr(text)
    } catch (error: Exception) {
        report.add(at, "parseable JSON", "parse error: " + error.message)
        return JsonObject()
    }
    return itObject(report, parsed, at)
}

// --- mismatch report --------------------------------------------------------

/** Collects comparison failures so one test reports every mismatch it saw. */
class ItReport {
    let fixture: String
    var messages: ArrayList<String>

    init(fixture: String) {
        this.fixture = fixture
        this.messages = ArrayList<String>()
    }

    func add(at: String, expected: String, actual: String): Unit {
        messages.add(fixture + ": " + at + ": expected " + expected + ", got " + actual)
    }
}

/** Fail the test once, with every collected mismatch, or return silently. */
func itFinish(report: ItReport): Unit {
    if (report.messages.size > 0) {
        @Fail(
            report.messages.size.toString() + " golden mismatch(es)\n" +
            String.join(report.messages.toArray(), delimiter: "\n")
        )
    }
}

// --- typed JSON accessors ---------------------------------------------------

func itKindName(value: JsonValue): String {
    match (value.kind()) {
        case JsonKind.JsObject => return "object"
        case JsonKind.JsArray => return "array"
        case JsonKind.JsString => return "string"
        case JsonKind.JsInt => return "integer"
        case JsonKind.JsFloat => return "float"
        case JsonKind.JsBool => return "boolean"
        case JsonKind.JsNull => return "null"
    }
}

func itObject(report: ItReport, value: JsonValue, at: String): JsonObject {
    match (value.kind()) {
        case JsonKind.JsObject => return value.asObject()
        case _ =>
            report.add(at, "object", itKindName(value))
            return JsonObject()
    }
}

func itArray(report: ItReport, value: JsonValue, at: String): Array<JsonValue> {
    match (value.kind()) {
        case JsonKind.JsArray => return value.asArray().getItems().toArray()
        case _ =>
            report.add(at, "array", itKindName(value))
            return Array<JsonValue>()
    }
}

func itString(report: ItReport, value: JsonValue, at: String): String {
    match (value.kind()) {
        case JsonKind.JsString => return value.asString().getValue()
        case _ =>
            report.add(at, "string", itKindName(value))
            return ""
    }
}

func itNumber(report: ItReport, value: JsonValue, at: String): Float64 {
    match (value.kind()) {
        case JsonKind.JsInt => return Float64(value.asInt().getValue())
        case JsonKind.JsFloat => return value.asFloat().getValue()
        case _ =>
            report.add(at, "number", itKindName(value))
            return 0.0
    }
}

func itInteger(report: ItReport, value: JsonValue, at: String): Int64 {
    match (value.kind()) {
        case JsonKind.JsInt => return value.asInt().getValue()
        case JsonKind.JsFloat =>
            report.add(at, "integer", "float " + formatFloatPy(value.asFloat().getValue()))
            return 0
        case _ =>
            report.add(at, "integer", itKindName(value))
            return 0
    }
}

func itBool(report: ItReport, value: JsonValue, at: String): Bool {
    match (value.kind()) {
        case JsonKind.JsBool => return value.asBool().getValue()
        case _ =>
            report.add(at, "boolean", itKindName(value))
            return false
    }
}

func itMember(report: ItReport, object: JsonObject, key: String, at: String): JsonValue {
    match (object.get(key)) {
        case Some(value) => return value
        case None =>
            report.add(at + "." + key, "a member", "missing")
            return JsonNull()
    }
}

func itObjectMember(report: ItReport, object: JsonObject, key: String, at: String): JsonObject {
    return itObject(report, itMember(report, object, key, at), at + "." + key)
}

func itArrayMember(report: ItReport, object: JsonObject, key: String, at: String): Array<JsonValue> {
    return itArray(report, itMember(report, object, key, at), at + "." + key)
}

func itStringMember(report: ItReport, object: JsonObject, key: String, at: String): String {
    return itString(report, itMember(report, object, key, at), at + "." + key)
}

func itNumberMember(report: ItReport, object: JsonObject, key: String, at: String): Float64 {
    return itNumber(report, itMember(report, object, key, at), at + "." + key)
}

func itIntegerMember(report: ItReport, object: JsonObject, key: String, at: String): Int64 {
    return itInteger(report, itMember(report, object, key, at), at + "." + key)
}

func itBoolMember(report: ItReport, object: JsonObject, key: String, at: String): Bool {
    return itBool(report, itMember(report, object, key, at), at + "." + key)
}

func itStringList(report: ItReport, value: JsonValue, at: String): ArrayList<String> {
    let items = itArray(report, value, at)
    let texts = ArrayList<String>()
    var index = 0
    while (index < items.size) {
        texts.add(itString(report, items[index], at + "[" + index.toString() + "]"))
        index += 1
    }
    return texts
}

func itIntList(report: ItReport, value: JsonValue, at: String): ArrayList<Int64> {
    let items = itArray(report, value, at)
    let numbers = ArrayList<Int64>()
    var index = 0
    while (index < items.size) {
        numbers.add(itInteger(report, items[index], at + "[" + index.toString() + "]"))
        index += 1
    }
    return numbers
}

// --- scalar comparisons -----------------------------------------------------

/** Printable form of a string value: control characters are escaped. */
func itShort(text: String): String {
    let flat = text.replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t")
    if (flat.size <= 160) {
        return flat
    }
    return flat[0..160] + "..."
}

func itQuote(text: String): String {
    return "\"" + itShort(text) + "\""
}

func itCheckString(report: ItReport, at: String, expected: String, actual: String): Unit {
    if (expected != actual) {
        report.add(at, itQuote(expected), itQuote(actual))
    }
}

func itCheckInt(report: ItReport, at: String, expected: Int64, actual: Int64): Unit {
    if (expected != actual) {
        report.add(at, expected.toString(), actual.toString())
    }
}

func itCheckBool(report: ItReport, at: String, expected: Bool, actual: Bool): Unit {
    if (expected != actual) {
        report.add(at, if (expected) { "true" } else { "false" }, if (actual) { "true" } else { "false" })
    }
}

func itCheckNumber(
    report: ItReport,
    at: String,
    expected: Float64,
    actual: Float64,
    tolerance: Float64
): Unit {
    let difference = if (actual > expected) { actual - expected } else { expected - actual }
    // `difference != difference` is the NaN case (not equal to itself).
    if (difference != difference || difference > tolerance) {
        report.add(
            at,
            formatFloatPy(expected) + " (+/-" + formatFloatPy(tolerance) + ")",
            formatFloatPy(actual)
        )
    }
}

func itCheckStrings(
    report: ItReport,
    at: String,
    expected: ArrayList<String>,
    actual: ArrayList<String>
): Unit {
    itCheckInt(report, at + ".count", Int64(expected.size), Int64(actual.size))
    var index = 0
    while (index < expected.size && index < actual.size) {
        itCheckString(report, at + "[" + index.toString() + "]", expected[index], actual[index])
        index += 1
    }
}

func itCheckInts(
    report: ItReport,
    at: String,
    expected: ArrayList<Int64>,
    actual: ArrayList<Int64>
): Unit {
    itCheckInt(report, at + ".count", Int64(expected.size), Int64(actual.size))
    var index = 0
    while (index < expected.size && index < actual.size) {
        itCheckInt(report, at + "[" + index.toString() + "]", expected[index], actual[index])
        index += 1
    }
}

// --- colours ----------------------------------------------------------------

/**
 * A colour reduced to comparable content.
 *
 * The two implementations hand the same value through different shapes: Python
 * emits pdfplumber's raw `stroking_color` (a tuple such as `(0,)`, an int for
 * shapes, or a name), the Cangjie model is always `PdfColor` (rendered as
 * `[0]`, `[1, 0, 0]` or a name). Comparing the *numbers* is what "Gray(0) and
 * [0] are equal" means, so a hex string is not special-cased here: it would be
 * treated as a name, and a mismatch against numeric components is a real
 * difference worth seeing.
 */
class ItColor {
    let components: Option<ArrayList<Float64>>
    let name: Option<String>
    let text: String

    init(components: Option<ArrayList<Float64>>, name: Option<String>, text: String) {
        this.components = components
        this.name = name
        this.text = text
    }
}

func itColorParts(report: ItReport, value: JsonValue, at: String): ItColor {
    match (value.kind()) {
        case JsonKind.JsArray =>
            let components = ArrayList<Float64>()
            for (item in value.asArray().getItems()) {
                components.add(itNumber(report, item, at))
            }
            return ItColor(Some(components), None, "")
        case JsonKind.JsString =>
            let text = value.asString().getValue()
            if (text.startsWith("(") && text.endsWith(")")) {
                // Python's `str(tuple)`: "(0,)", "(1.0, 0.0, 0.0)".
                let components = ArrayList<Float64>()
                for (part in text[1..text.size - 1].split(",")) {
                    let trimmed = part.trimAscii()
                    if (trimmed.isEmpty()) {
                        continue
                    }
                    match (Float64.tryParse(trimmed)) {
                        case Some(number) => components.add(number)
                        case None => ()
                    }
                }
                return ItColor(Some(components), None, text)
            }
            match (Float64.tryParse(text)) {
                case Some(number) => return ItColor(Some(ArrayList<Float64>([number])), None, text)
                case None => return ItColor(None, Some(text), text)
            }
        case _ =>
            report.add(at, "colour", itKindName(value))
            return ItColor(None, None, "")
    }
}

func itCheckColor(report: ItReport, at: String, expected: JsonValue, actual: JsonValue): Unit {
    let golden = itColorParts(report, expected, at + "(golden)")
    let cangjie = itColorParts(report, actual, at)
    match (golden.components) {
        case Some(expectedParts) =>
            match (cangjie.components) {
                case Some(actualParts) =>
                    itCheckInt(
                        report,
                        at + ".components",
                        Int64(expectedParts.size),
                        Int64(actualParts.size)
                    )
                    var index = 0
                    while (index < expectedParts.size && index < actualParts.size) {
                        itCheckNumber(
                            report,
                            at + "[" + index.toString() + "]",
                            expectedParts[index],
                            actualParts[index],
                            IT_COLOR_TOLERANCE
                        )
                        index += 1
                    }
                case None => report.add(at, "numeric " + golden.text, "named " + cangjie.text)
            }
        case None =>
            match (cangjie.components) {
                case Some(_) => report.add(at, "named " + golden.text, "numeric " + cangjie.text)
                case None => itCheckString(report, at, golden.text, cangjie.text)
            }
    }
}

// --- structure comparisons --------------------------------------------------

func itCheckBox(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    for (key in ["x0", "y0", "x1", "y1"]) {
        itCheckNumber(
            report,
            at + "." + key,
            itNumberMember(report, golden, key, at),
            itNumberMember(report, actual, key, at),
            IT_BBOX_TOLERANCE
        )
    }
}

func itCheckMetadata(
    report: ItReport,
    at: String,
    golden: JsonObject,
    actual: JsonObject
): Unit {
    itCheckInt(
        report,
        at + ".pages",
        itIntegerMember(report, golden, "pages", at),
        itIntegerMember(report, actual, "pages", at)
    )
    itCheckString(
        report,
        at + ".version",
        itStringMember(report, golden, "version", at),
        itStringMember(report, actual, "version", at)
    )
    itCheckBool(
        report,
        at + ".encrypted",
        itBoolMember(report, golden, "encrypted", at),
        itBoolMember(report, actual, "encrypted", at)
    )
    for (key in ["page_w", "page_h"]) {
        itCheckNumber(
            report,
            at + "." + key,
            itNumberMember(report, golden, key, at),
            itNumberMember(report, actual, key, at),
            IT_SIZE_TOLERANCE
        )
    }
    for (key in ["title", "author", "producer"]) {
        itCheckString(
            report,
            at + "." + key,
            itStringMember(report, golden, key, at),
            itStringMember(report, actual, key, at)
        )
    }
    itCheckStrings(
        report,
        at + ".fonts",
        itStringList(report, itMember(report, golden, "fonts", at), at + ".fonts"),
        itStringList(report, itMember(report, actual, "fonts", at), at + ".fonts")
    )
}

func itCheckChars(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    let expected = itArrayMember(report, golden, "chars", at)
    let found = itArrayMember(report, actual, "chars", at)
    itCheckInt(report, at + ".chars.count", Int64(expected.size), Int64(found.size))
    var index = 0
    while (index < expected.size && index < found.size) {
        let itemWhere = at + ".chars[" + index.toString() + "]"
        let goldenChar = itObject(report, expected[index], itemWhere)
        let cangjieChar = itObject(report, found[index], itemWhere)
        itCheckString(
            report,
            itemWhere + ".type",
            itStringMember(report, goldenChar, "type", itemWhere),
            itStringMember(report, cangjieChar, "type", itemWhere)
        )
        itCheckString(
            report,
            itemWhere + ".text",
            itStringMember(report, goldenChar, "text", itemWhere),
            itStringMember(report, cangjieChar, "text", itemWhere)
        )
        itCheckString(
            report,
            itemWhere + ".fontname",
            itStringMember(report, goldenChar, "fontname", itemWhere),
            itStringMember(report, cangjieChar, "fontname", itemWhere)
        )
        itCheckNumber(
            report,
            itemWhere + ".size",
            itNumberMember(report, goldenChar, "size", itemWhere),
            itNumberMember(report, cangjieChar, "size", itemWhere),
            IT_SIZE_TOLERANCE
        )
        itCheckBox(report, itemWhere, goldenChar, cangjieChar)
        itCheckColor(
            report,
            itemWhere + ".color",
            itMember(report, goldenChar, "color", itemWhere),
            itMember(report, cangjieChar, "color", itemWhere)
        )
        itCheckInt(
            report,
            itemWhere + ".page",
            itIntegerMember(report, goldenChar, "page", itemWhere),
            itIntegerMember(report, cangjieChar, "page", itemWhere)
        )
        index += 1
    }
}

func itCheckWords(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    let expected = itArrayMember(report, golden, "words", at)
    let found = itArrayMember(report, actual, "words", at)
    itCheckInt(report, at + ".words.count", Int64(expected.size), Int64(found.size))
    // The text sequence is the contract (order and count); bbox/font/size are
    // compared too because they are cheap and catch a misplaced word.
    let expectedTexts = ArrayList<String>()
    let foundTexts = ArrayList<String>()
    var index = 0
    while (index < expected.size && index < found.size) {
        let itemWhere = at + ".words[" + index.toString() + "]"
        let goldenWord = itObject(report, expected[index], itemWhere)
        let cangjieWord = itObject(report, found[index], itemWhere)
        let goldenText = itStringMember(report, goldenWord, "text", itemWhere)
        let cangjieText = itStringMember(report, cangjieWord, "text", itemWhere)
        expectedTexts.add(goldenText)
        foundTexts.add(cangjieText)
        itCheckString(report, itemWhere + ".fontname",
            itStringMember(report, goldenWord, "fontname", itemWhere),
            itStringMember(report, cangjieWord, "fontname", itemWhere))
        itCheckNumber(report, itemWhere + ".size",
            itNumberMember(report, goldenWord, "size", itemWhere),
            itNumberMember(report, cangjieWord, "size", itemWhere),
            IT_SIZE_TOLERANCE)
        itCheckBox(report, itemWhere, goldenWord, cangjieWord)
        index += 1
    }
    itCheckStrings(report, at + ".words.text", expectedTexts, foundTexts)
}

func itCheckRects(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    let expected = itArrayMember(report, golden, "rects", at)
    let found = itArrayMember(report, actual, "rects", at)
    itCheckInt(report, at + ".rects.count", Int64(expected.size), Int64(found.size))
    var index = 0
    while (index < expected.size && index < found.size) {
        let itemWhere = at + ".rects[" + index.toString() + "]"
        let goldenRect = itObject(report, expected[index], itemWhere)
        let cangjieRect = itObject(report, found[index], itemWhere)
        itCheckBox(report, itemWhere, goldenRect, cangjieRect)
        itCheckNumber(report, itemWhere + ".width",
            itNumberMember(report, goldenRect, "width", itemWhere),
            itNumberMember(report, cangjieRect, "width", itemWhere),
            IT_SIZE_TOLERANCE)
        itCheckBool(report, itemWhere + ".stroke",
            itBoolMember(report, goldenRect, "stroke", itemWhere),
            itBoolMember(report, cangjieRect, "stroke", itemWhere))
        itCheckColor(report, itemWhere + ".color",
            itMember(report, goldenRect, "color", itemWhere),
            itMember(report, cangjieRect, "color", itemWhere))
        // `fill` is intentionally not compared: Python derives it from
        // "non_stroking_color is not None" (true for stroke-only rects), the
        // Cangjie engine from the painting operator. See the file header and
        // `rectFillFollowsThePaintingOperator`.
        itCheckInt(report, itemWhere + ".page",
            itIntegerMember(report, goldenRect, "page", itemWhere),
            itIntegerMember(report, cangjieRect, "page", itemWhere))
        index += 1
    }
}

func itCheckLines(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    let expected = itArrayMember(report, golden, "lines", at)
    let found = itArrayMember(report, actual, "lines", at)
    itCheckInt(report, at + ".lines.count", Int64(expected.size), Int64(found.size))
    var index = 0
    while (index < expected.size && index < found.size) {
        let itemWhere = at + ".lines[" + index.toString() + "]"
        let goldenLine = itObject(report, expected[index], itemWhere)
        let cangjieLine = itObject(report, found[index], itemWhere)
        itCheckBox(report, itemWhere, goldenLine, cangjieLine)
        itCheckNumber(report, itemWhere + ".width",
            itNumberMember(report, goldenLine, "width", itemWhere),
            itNumberMember(report, cangjieLine, "width", itemWhere),
            IT_SIZE_TOLERANCE)
        itCheckBool(report, itemWhere + ".stroke",
            itBoolMember(report, goldenLine, "stroke", itemWhere),
            itBoolMember(report, cangjieLine, "stroke", itemWhere))
        itCheckColor(report, itemWhere + ".color",
            itMember(report, goldenLine, "color", itemWhere),
            itMember(report, cangjieLine, "color", itemWhere))
        itCheckInt(report, itemWhere + ".page",
            itIntegerMember(report, goldenLine, "page", itemWhere),
            itIntegerMember(report, cangjieLine, "page", itemWhere))
        index += 1
    }
}

func itCheckCurves(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    let expected = itArrayMember(report, golden, "curves", at)
    let found = itArrayMember(report, actual, "curves", at)
    itCheckInt(report, at + ".curves.count", Int64(expected.size), Int64(found.size))
    var index = 0
    while (index < expected.size && index < found.size) {
        let itemWhere = at + ".curves[" + index.toString() + "]"
        itCheckBox(
            report,
            itemWhere,
            itObject(report, expected[index], itemWhere),
            itObject(report, found[index], itemWhere)
        )
        index += 1
    }
}

func itCheckImages(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    let expected = itArrayMember(report, golden, "images", at)
    let found = itArrayMember(report, actual, "images", at)
    itCheckInt(report, at + ".images.count", Int64(expected.size), Int64(found.size))
    var index = 0
    while (index < expected.size && index < found.size) {
        let itemWhere = at + ".images[" + index.toString() + "]"
        let goldenImage = itObject(report, expected[index], itemWhere)
        let cangjieImage = itObject(report, found[index], itemWhere)
        itCheckString(report, itemWhere + ".stream_id",
            itStringMember(report, goldenImage, "stream_id", itemWhere),
            itStringMember(report, cangjieImage, "stream_id", itemWhere))
        itCheckString(report, itemWhere + ".format",
            itStringMember(report, goldenImage, "format", itemWhere),
            itStringMember(report, cangjieImage, "format", itemWhere))
        for (key in ["width", "height"]) {
            itCheckNumber(report, itemWhere + "." + key,
                itNumberMember(report, goldenImage, key, itemWhere),
                itNumberMember(report, cangjieImage, key, itemWhere),
                IT_SIZE_TOLERANCE)
        }
        itCheckBox(report, itemWhere, goldenImage, cangjieImage)
        index += 1
    }
}

func itCheckCells(
    report: ItReport,
    at: String,
    expected: Array<JsonValue>,
    found: Array<JsonValue>
): Unit {
    itCheckInt(report, at + ".rows", Int64(expected.size), Int64(found.size))
    var row = 0
    while (row < expected.size && row < found.size) {
        let rowWhere = at + "[" + row.toString() + "]"
        let expectedRow = itArray(report, expected[row], rowWhere)
        let foundRow = itArray(report, found[row], rowWhere)
        itCheckInt(report, rowWhere + ".cols", Int64(expectedRow.size), Int64(foundRow.size))
        var column = 0
        while (column < expectedRow.size && column < foundRow.size) {
            itCheckString(
                report,
                rowWhere + "[" + column.toString() + "]",
                itString(report, expectedRow[column], rowWhere),
                itString(report, foundRow[column], rowWhere)
            )
            column += 1
        }
        row += 1
    }
}

func itCheckTables(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    let expected = itArrayMember(report, golden, "tables", at)
    let found = itArrayMember(report, actual, "tables", at)
    itCheckInt(report, at + ".tables.count", Int64(expected.size), Int64(found.size))
    var index = 0
    while (index < expected.size && index < found.size) {
        let itemWhere = at + ".tables[" + index.toString() + "]"
        let goldenTable = itObject(report, expected[index], itemWhere)
        let cangjieTable = itObject(report, found[index], itemWhere)
        for (key in ["rows", "cols"]) {
            itCheckInt(report, itemWhere + "." + key,
                itIntegerMember(report, goldenTable, key, itemWhere),
                itIntegerMember(report, cangjieTable, key, itemWhere))
        }
        itCheckCells(
            report,
            itemWhere + ".cells",
            itArrayMember(report, goldenTable, "cells", itemWhere),
            itArrayMember(report, cangjieTable, "cells", itemWhere)
        )
        itCheckBox(report, itemWhere, goldenTable, cangjieTable)
        itCheckInt(report, itemWhere + ".page",
            itIntegerMember(report, goldenTable, "page", itemWhere),
            itIntegerMember(report, cangjieTable, "page", itemWhere))
        index += 1
    }
}

func itCheckPage(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    itCheckNumber(report, at + ".width",
        itNumberMember(report, golden, "width", at),
        itNumberMember(report, actual, "width", at),
        IT_SIZE_TOLERANCE)
    itCheckNumber(report, at + ".height",
        itNumberMember(report, golden, "height", at),
        itNumberMember(report, actual, "height", at),
        IT_SIZE_TOLERANCE)
    itCheckChars(report, at, golden, actual)
    itCheckWords(report, at, golden, actual)
    itCheckRects(report, at, golden, actual)
    itCheckLines(report, at, golden, actual)
    itCheckCurves(report, at, golden, actual)
    itCheckImages(report, at, golden, actual)
    itCheckTables(report, at, golden, actual)
}

func itCheckDocument(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    itCheckMetadata(
        report,
        at + ".metadata",
        itObjectMember(report, golden, "metadata", at),
        itObjectMember(report, actual, "metadata", at)
    )
    let expectedCount = itIntegerMember(report, golden, "pageCount", at)
    itCheckInt(report, at + ".pageCount", expectedCount, itIntegerMember(report, actual, "pageCount", at))
    let expectedPages = itArrayMember(report, golden, "pages", at)
    let foundPages = itArrayMember(report, actual, "pages", at)
    itCheckInt(report, at + ".pages.count", Int64(expectedPages.size), Int64(foundPages.size))
    var index = 0
    while (index < expectedPages.size && index < foundPages.size) {
        let pageWhere = at + ".pages[" + index.toString() + "]"
        itCheckPage(
            report,
            pageWhere,
            itObject(report, expectedPages[index], pageWhere),
            itObject(report, foundPages[index], pageWhere)
        )
        index += 1
    }
}

func itCheckFonts(report: ItReport, at: String, golden: JsonObject, actual: JsonObject): Unit {
    let expected = itArrayMember(report, golden, "fonts", at)
    let found = itArrayMember(report, actual, "fonts", at)
    itCheckInt(report, at + ".fonts.count", Int64(expected.size), Int64(found.size))
    var index = 0
    while (index < expected.size && index < found.size) {
        let itemWhere = at + ".fonts[" + index.toString() + "]"
        let goldenFont = itObject(report, expected[index], itemWhere)
        let cangjieFont = itObject(report, found[index], itemWhere)
        itCheckString(report, itemWhere + ".fontname",
            itStringMember(report, goldenFont, "fontname", itemWhere),
            itStringMember(report, cangjieFont, "fontname", itemWhere))
        itCheckInts(report, itemWhere + ".pages",
            itIntList(report, itMember(report, goldenFont, "pages", itemWhere), itemWhere + ".pages"),
            itIntList(report, itMember(report, cangjieFont, "pages", itemWhere), itemWhere + ".pages"))
        itCheckInt(report, itemWhere + ".charCount",
            itIntegerMember(report, goldenFont, "charCount", itemWhere),
            itIntegerMember(report, cangjieFont, "charCount", itemWhere))
        for (key in ["sizeMin", "sizeMax"]) {
            itCheckNumber(report, itemWhere + "." + key,
                itNumberMember(report, goldenFont, key, itemWhere),
                itNumberMember(report, cangjieFont, key, itemWhere),
                IT_SIZE_TOLERANCE)
        }
        // Python stores `str(tuple)` ("(0,)", "(1.0, 0.0, 0.0)"), Cangjie the
        // same text: compare the numeric components, not the spelling.
        let expectedColors = itArrayMember(report, goldenFont, "colors", itemWhere)
        let foundColors = itArrayMember(report, cangjieFont, "colors", itemWhere)
        itCheckInt(report, itemWhere + ".colors.count", Int64(expectedColors.size), Int64(foundColors.size))
        var colorIndex = 0
        while (colorIndex < expectedColors.size && colorIndex < foundColors.size) {
            itCheckColor(
                report,
                itemWhere + ".colors[" + colorIndex.toString() + "]",
                expectedColors[colorIndex],
                foundColors[colorIndex]
            )
            colorIndex += 1
        }
        index += 1
    }
}

// --- extraction through the engine -----------------------------------------

func itOpen(path: String): PdfDocument {
    return PdfDocument.open(path, None)
}

func itMetadataJson(report: ItReport, path: String): JsonObject {
    let document = itOpen(path)
    try {
        return itParseObject(report, metadataToJson(document.metadata()), path + ".metadata")
    } finally {
        document.close()
    }
}

func itPageJson(report: ItReport, path: String, pageNumber: Int64): JsonObject {
    let document = itOpen(path)
    try {
        let page = document.page(pageNumber)
        let data = extractPage(document, page)
        data.tables.add(all: extractTables(page, data))
        return itParseObject(report, pageToJson(data), path + ".page" + pageNumber.toString())
    } finally {
        document.close()
    }
}

func itDocumentJson(report: ItReport, path: String): JsonObject {
    let document = itOpen(path)
    try {
        let pages = ArrayList<PageData>()
        var number: Int64 = 1
        while (number <= document.pageCount) {
            let page = document.page(number)
            let data = extractPage(document, page)
            data.tables.add(all: extractTables(page, data))
            pages.add(data)
            number += 1
        }
        return itParseObject(report, documentToJson(document.metadata(), pages, None), path + ".document")
    } finally {
        document.close()
    }
}

// --- tool layer -------------------------------------------------------------

/**
 * Invoke a tool exactly like `server.cj` does: an expected failure comes back as
 * an error response (the `NativeFuncTool.invoke` call itself throws).
 */
func itInvoke(tool: Tool, arguments: HashMap<String, JsonValue>): ToolResponse {
    try {
        return tool.invoke(arguments)
    } catch (error: PdfToolError) {
        return ToolResponse(error.message, isError: true)
    } catch (error: ToolException) {
        return ToolResponse(error.message, isError: true)
    }
}

func itArguments(): HashMap<String, JsonValue> {
    return HashMap<String, JsonValue>()
}

func itSuccess(report: ItReport, response: ToolResponse, at: String): JsonObject {
    if (response.isError) {
        report.add(at + ".isError", "false", "true (" + itShort(response.content) + ")")
    }
    return itParseObject(report, response.content, at)
}

func itFailure(report: ItReport, response: ToolResponse, at: String): String {
    if (!response.isError) {
        report.add(at + ".isError", "true", "false (" + itShort(response.content) + ")")
    }
    return response.content
}

func itGoldenErrorFragment(report: ItReport, caseName: String): String {
    let errors = itParseObject(report, itReadText(IT_GOLDENS + "errors.json"), "tests/goldens/errors.json")
    let cases = itObjectMember(report, errors, "cases", "errors")
    let entry = itObjectMember(report, cases, caseName, "errors.cases")
    return itStringMember(report, entry, "fragment", "errors.cases." + caseName)
}

// --- CSV --------------------------------------------------------------------

/** RFC 4180 rows: quoted cells may contain `,`, `"` (doubled) and newlines. */
func itCsvRows(source: String): ArrayList<Array<String>> {
    let rows = ArrayList<Array<String>>()
    // Drop the UTF-8 BOM before parsing: it precedes the first section title.
    let text = if (source.startsWith(IT_BOM)) {
        source[3..source.size]
    } else {
        source
    }
    if (text.size == 0) {
        return rows
    }
    var cells = ArrayList<String>()
    var chunks = ArrayList<String>()
    var quoted = false
    var index: Int64 = 0
    var segmentStart: Int64 = 0
    while (index < text.size) {
        let byte = text[index]
        if (quoted) {
            if (byte == b'"') {
                if (index + 1 < text.size && text[index + 1] == b'"') {
                    chunks.add(text[segmentStart..index])
                    chunks.add("\"")
                    index += 2
                    segmentStart = index
                    continue
                }
                chunks.add(text[segmentStart..index])
                quoted = false
                index += 1
                segmentStart = index
                continue
            }
            index += 1
            continue
        }
        if (byte == b'"' && index == segmentStart) {
            quoted = true
            index += 1
            segmentStart = index
            continue
        }
        if (byte == b',' || byte == b'\n') {
            chunks.add(text[segmentStart..index])
            cells.add(String.join(chunks.toArray(), delimiter: ""))
            chunks = ArrayList<String>()
            if (byte == b'\n') {
                rows.add(cells.toArray())
                cells = ArrayList<String>()
            }
            index += 1
            segmentStart = index
            continue
        }
        if (byte == b'\r') {
            index += 1
            segmentStart = index
            continue
        }
        index += 1
    }
    if (segmentStart < text.size || !cells.isEmpty()) {
        chunks.add(text[segmentStart..text.size])
        cells.add(String.join(chunks.toArray(), delimiter: ""))
        rows.add(cells.toArray())
    }
    return rows
}

/** One `# <type>` section: its title row, the header row, then data rows. */
class ItCsvSection {
    let title: String
    var rows: ArrayList<Array<String>>

    init(title: String) {
        this.title = title
        this.rows = ArrayList<Array<String>>()
    }
}

func itCsvSections(text: String): ArrayList<ItCsvSection> {
    let sections = ArrayList<ItCsvSection>()
    var current = ItCsvSection("")
    for (row in itCsvRows(text)) {
        if (row.size > 0 && row[0].startsWith("# ")) {
            current = ItCsvSection(row[0])
            sections.add(current)
            continue
        }
        current.rows.add(row)
    }
    return sections
}

/** Column of the `text` field per section, or -1 when the section has none. */
func itCsvTextColumn(title: String): Int64 {
    match (title) {
        case "# chars" => return 5
        case "# words" => return 5
        case "# tables" => return 4
        case _ => return -1
    }
}

func itCsvCell(row: Array<String>, column: Int64): String {
    if (column < 0 || column >= row.size) {
        return ""
    }
    return row[column]
}

func itCheckCsv(
    report: ItReport,
    at: String,
    goldenText: String,
    actualText: String,
    compareWordText: Bool
): Unit {
    if (!actualText.startsWith(IT_BOM)) {
        report.add(at + ".bom", "a leading UTF-8 BOM", "no BOM")
    }
    match (actualText.indexOf("\r\n")) {
        case Some(_) => report.add(at + ".newlines", "bare LF only", "CRLF found")
        case None => ()
    }
    let expected = itCsvSections(goldenText)
    let found = itCsvSections(actualText)
    itCheckInt(report, at + ".sections.count", Int64(expected.size), Int64(found.size))
    var index = 0
    while (index < expected.size && index < found.size) {
        let sectionWhere = at + "[" + index.toString() + "]"
        itCheckString(report, sectionWhere + ".title", expected[index].title, found[index].title)
        let expectedRows = expected[index].rows
        let foundRows = found[index].rows
        itCheckInt(
            report,
            sectionWhere + ".rows",
            Int64(expectedRows.size),
            Int64(foundRows.size)
        )
        let textColumn = itCsvTextColumn(expected[index].title)
        let compareText = textColumn >= 0 && (compareWordText || expected[index].title != "# words")
        if (compareText) {
            let expectedTexts = ArrayList<String>()
            let foundTexts = ArrayList<String>()
            var row = 0
            while (row < expectedRows.size && row < foundRows.size) {
                expectedTexts.add(itCsvCell(expectedRows[row], textColumn))
                foundTexts.add(itCsvCell(foundRows[row], textColumn))
                row += 1
            }
            itCheckStrings(report, sectionWhere + ".text", expectedTexts, foundTexts)
        }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Metadata

@Test
class IntegrationMetadataTest {
    @TestCase
    func metadataMatchesGoldenForEveryReadableFixture() {
        let fixtures = [
            "text", "multipage", "table", "image", "styled", "blank",
            "mediabox", "jpeg", "quoted-table", "xref-stream", "xref-stream-flate"
        ]
        for (name in fixtures) {
            let report = ItReport("metadata/" + name)
            let golden = itGoldenObject(report, name, "metadata")
            let actual = itMetadataJson(report, itFixture(name))
            itCheckMetadata(report, name, golden, actual)
            itFinish(report)
        }
    }

    @TestCase
    func metadataOfAZeroPageDocumentReportsNoPageSize() {
        let report = ItReport("metadata/zero")
        let golden = itGoldenObject(report, "zero", "metadata")
        let actual = itMetadataJson(report, itFixture("zero"))
        itCheckMetadata(report, "zero", golden, actual)
        // The goldens pin these; assert them directly too so a broken golden
        // generator cannot make the test vacuous.
        itCheckInt(report, "zero.pages", 0, itIntegerMember(report, actual, "pages", "zero"))
        itCheckNumber(report, "zero.page_w", 0.0, itNumberMember(report, actual, "page_w", "zero"), IT_SIZE_TOLERANCE)
        itCheckNumber(report, "zero.page_h", 0.0, itNumberMember(report, actual, "page_h", "zero"), IT_SIZE_TOLERANCE)
        itFinish(report)
    }

    @TestCase
    func metadataOfAMediaBoxWithAnOffsetOriginKeepsTheBoxSize() {
        let report = ItReport("metadata/mediabox")
        let actual = itMetadataJson(report, itFixture("mediabox"))
        // MediaBox [0 100 612 892]: 612 x 792 even though the origin is y = 100.
        itCheckNumber(report, "mediabox.page_w", 612.0, itNumberMember(report, actual, "page_w", "mediabox"), IT_SIZE_TOLERANCE)
        itCheckNumber(report, "mediabox.page_h", 792.0, itNumberMember(report, actual, "page_h", "mediabox"), IT_SIZE_TOLERANCE)
        itFinish(report)
    }
}

// ---------------------------------------------------------------------------
// Page extraction

@Test
class IntegrationPageTest {
    @TestCase
    func pageOneMatchesGoldenForTextLikeFixtures() {
        let fixtures = [
            "text", "multipage", "image", "jpeg", "blank",
            "mediabox", "xref-stream", "xref-stream-flate"
        ]
        for (name in fixtures) {
            let report = ItReport("page1/" + name)
            let golden = itGoldenObject(report, name, "page1")
            let actual = itPageJson(report, itFixture(name), 1)
            itCheckPage(report, name + ".page1", golden, actual)
            itFinish(report)
        }
    }

    @TestCase
    func pageOneMatchesGoldenForTheStyledDocument() {
        let report = ItReport("page1/styled")
        let golden = itGoldenObject(report, "styled", "page1")
        let actual = itPageJson(report, itFixture("styled"), 1)
        itCheckPage(report, "styled.page1", golden, actual)
        itFinish(report)
    }

    @TestCase
    func tablePageKeepsCellsAndGridBbox() {
        let report = ItReport("page1/table")
        let golden = itGoldenObject(report, "table", "page1")
        let actual = itPageJson(report, itFixture("table"), 1)
        itCheckPage(report, "table.page1", golden, actual)
        // The empty cell is the point of the fixture: pdfplumber reports None,
        // the extractor turns it into "". Pin the shape explicitly.
        let tables = itArrayMember(report, actual, "tables", "table.page1")
        itCheckInt(report, "table.page1.tables.count", 1, Int64(tables.size))
        if (tables.size > 0) {
            let table = itObject(report, tables[0], "table.page1.tables[0]")
            itCheckInt(report, "table.page1.tables[0].rows", 2, itIntegerMember(report, table, "rows", "table"))
            itCheckInt(report, "table.page1.tables[0].cols", 2, itIntegerMember(report, table, "cols", "table"))
            let cells = itArrayMember(report, table, "cells", "table")
            if (cells.size == 2) {
                let first = itArray(report, cells[0], "table.cells[0]")
                let second = itArray(report, cells[1], "table.cells[1]")
                itCheckString(report, "table.cells[0][0]", "Header A", itString(report, first[0], "table.cells[0][0]"))
                itCheckString(report, "table.cells[0][1]", "Header B", itString(report, first[1], "table.cells[0][1]"))
                itCheckString(report, "table.cells[1][0]", "", itString(report, second[0], "table.cells[1][0]"))
                itCheckString(report, "table.cells[1][1]", "Row B1", itString(report, second[1], "table.cells[1][1]"))
            }
        }
        itFinish(report)
    }

    @TestCase
    func rectFillFollowsThePaintingOperator() {
        let report = ItReport("page1/table/fill")
        let actual = itPageJson(report, itFixture("table"), 1)
        let rects = itArrayMember(report, actual, "rects", "table.page1")
        itCheckInt(report, "table.page1.rects.count", 1, Int64(rects.size))
        if (rects.size > 0) {
            let rect = itObject(report, rects[0], "table.page1.rects[0]")
            // `c.rect(...)` defaults to stroke-only (`S`), so the Cangjie engine
            // reports fill = false. The Python extractor reports true because it
            // tests `non_stroking_color is not None` instead of pdfplumber's own
            // `fill` flag - a deviation reported to the planner, pinned here so
            // it cannot change unnoticed.
            itCheckBool(report, "table.page1.rects[0].fill", false, itBoolMember(report, rect, "fill", "table"))
            itCheckBool(report, "table.page1.rects[0].stroke", true, itBoolMember(report, rect, "stroke", "table"))
        }
        itFinish(report)
    }

    @TestCase
    func wordOrderFollowsDescendingBaselineInsteadOfContentStreamOrder() {
        // `quoted-table.pdf` draws `a,"b` (y = 710), `c` (y = 698) and `plain`
        // (y = 700) in that order, i.e. not top-to-bottom. pdfplumber groups
        // words in content-stream order (a,"b, c, plain); the Cangjie splitter
        // orders them by descending baseline (a,"b, plain, c). This is the one
        // known word-order deviation; it is asserted here so a change to either
        // behaviour shows up, and the CSV comparison for this fixture skips the
        // `# words` text column accordingly.
        let report = ItReport("page1/quoted-table/word-order")
        let actual = itPageJson(report, itFixture("quoted-table"), 1)
        let words = itArrayMember(report, actual, "words", "quoted-table.page1")
        let texts = ArrayList<String>()
        for (word in words) {
            texts.add(itStringMember(report, itObject(report, word, "word"), "text", "word"))
        }
        itCheckStrings(
            report,
            "quoted-table.page1.words.text",
            ArrayList<String>(["a,\"b", "plain", "c"]),
            texts
        )
        itFinish(report)
    }
}

