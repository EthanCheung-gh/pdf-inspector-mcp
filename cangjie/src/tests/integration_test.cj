    @TestCase
    func exportJsonToolMatchesTheGoldenDocument() {
        let report = ItReport("tool/export_json")
        let golden = itGoldenObject(report, "multipage", "export")
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("multipage")))
        let response = itSuccess(report, itInvoke(pdf_export, arguments), "pdf_export")
        itCheckInt(report, "pdf_export.inline", 1,
            if (itBoolMember(report, response, "inline", "pdf_export")) { 1 } else { 0 })
        itCheckString(report, "pdf_export.format", "json",
            itStringMember(report, response, "format", "pdf_export"))
        itCheckString(report, "pdf_export.scope", "document",
            itStringMember(report, response, "scope", "pdf_export"))
        itCheckString(report, "pdf_export.suggested_filename", "multipage-all.json",
            itStringMember(report, response, "suggested_filename", "pdf_export"))
        itCheckStrings(report, "pdf_export.object_types",
            itStringList(report, itMember(report, golden, "objectTypes", "export"),
                "multipage.export.objectTypes"),
            itStringList(report, itMember(report, response, "object_types", "pdf_export"),
                "pdf_export.object_types"))
        // The payload itself is the export document; compare it field by field.
        let content = itStringMember(report, response, "content", "pdf_export")
        let document = itParseObject(report, content, "pdf_export.content")
        itCheckDocument(report, "multipage.export", golden, document)
        itFinish(report)
    }

    @TestCase
    func exportCsvToAFileMatchesTheGoldenRows() {
        let report = ItReport("tool/export_csv")
        let target = itTempPath("export-table.csv")
        removeIfExists(target)
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("table")))
        arguments.add("format", JsonString("csv"))
        arguments.add("output_path", JsonString(target))
        let response = itSuccess(report, itInvoke(pdf_export, arguments), "pdf_export")
        try {
            itCheckString(report, "pdf_export.format", "csv",
                itStringMember(report, response, "format", "pdf_export"))
            itCheckString(report, "pdf_export.path", target,
                itStringMember(report, response, "path", "pdf_export"))
            let raw = File.readFrom(target)
            itCheckInt(report, "csv.byte_length", Int64(raw.size),
                itIntegerMember(report, response, "bytes", "pdf_export"))
            // The BOM must reach the file as the three UTF-8 bytes.
            if (raw.size < 3 || raw[0] != UInt8(0xEF) || raw[1] != UInt8(0xBB) || raw[2] != UInt8(0xBF)) {
                report.add("csv.bytes", "EF BB BF", "something else")
            }
            let written = String.fromUtf8(raw)
            // Sanity: the parser must see the seven canonical sections, in
            // order, with data rows - otherwise the golden comparison below
            // could pass on two empty parses.
            let sections = itCsvSections(written)
            itCheckInt(report, "table.csv.sections", 7, Int64(sections.size))
            let titles = ArrayList<String>()
            for (section in sections) {
                titles.add(section.title)
            }
            itCheckStrings(
                report,
                "table.csv.section_titles",
                ArrayList<String>(
                    ["# chars", "# words", "# rects", "# lines", "# curves", "# images", "# tables"]
                ),
                titles
            )
            if (sections.size > 6) {
                // 22 chars + header, 6 words + header, 1 rect, 2 lines, 4 table cells (+ headers).
                itCheckInt(report, "table.csv.char_rows", 23, Int64(sections[0].rows.size))
                itCheckInt(report, "table.csv.word_rows", 7, Int64(sections[1].rows.size))
                itCheckInt(report, "table.csv.table_rows", 5, Int64(sections[6].rows.size))
            }
            itCheckCsv(
                report,
                "table.csv",
                itGoldenText("table", "export", ".csv"),
                written,
                true
            )
            // Inline and on-disk CSV must be the same content.
            let inlineArguments = itArguments()
            inlineArguments.add("path", JsonString(itFixture("table")))
            inlineArguments.add("format", JsonString("csv"))
            let inline = itSuccess(report, itInvoke(pdf_export, inlineArguments), "pdf_export.inline")
            itCheckString(report, "csv.inline_vs_file", written,
                itStringMember(report, inline, "content", "pdf_export.inline"))
        } finally {
            removeIfExists(target)
        }
        itFinish(report)
    }

    @TestCase
    func exportCsvKeepsAQuotedCellWithAQuoteAndANewline() {
        let report = ItReport("tool/export_csv_quoted")
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("quoted-table")))
        arguments.add("format", JsonString("csv"))
        let objectTypes = ArrayList<JsonValue>()
        objectTypes.add(JsonString("table"))
        arguments.add("object_types", JsonArray(objectTypes.toArray()))
        let response = itSuccess(report, itInvoke(pdf_export, arguments), "pdf_export")
        let content = itStringMember(report, response, "content", "pdf_export")
        let sections = itCsvSections(content)
        itCheckInt(report, "quoted-table.csv.sections", 1, Int64(sections.size))
        if (sections.size == 1) {
            itCheckString(report, "quoted-table.csv.sections[0].title", "# tables", sections[0].title)
            // Header + four cells.
            itCheckInt(report, "quoted-table.csv.rows", 5, Int64(sections[0].rows.size))
            if (sections[0].rows.size == 5) {
                let cells = ArrayList<String>()
                for (row in sections[0].rows) {
                    cells.add(itCsvCell(row, 4))
                }
                itCheckStrings(
                    report,
                    "quoted-table.csv.cells",
                    ArrayList<String>(["text", "a,\"b\nc", "plain", "", ""]),
                    cells
                )
            }
        }
        // The RFC 4180 form with the doubled quote and the bare LF.
        match (content.indexOf("\"a,\"\"b\nc\"")) {
            case Some(_) => ()
            case None => report.add("quoted-table.csv.quoting", "\"a,\"\"b\\nc\"", "not found")
        }
        match (content.indexOf("\r\n")) {
            case Some(_) => report.add("quoted-table.csv.newlines", "bare LF only", "CRLF found")
            case None => ()
        }
        itFinish(report)
    }
}

// ---------------------------------------------------------------------------
// Error paths

@Test
class IntegrationErrorTest {
    func expectFailure(caseName: String, tool: Tool, arguments: HashMap<String, JsonValue>): Unit {
        let report = ItReport("error/" + caseName)
        let fragment = itGoldenErrorFragment(report, caseName)
        let message = itFailure(report, itInvoke(tool, arguments), caseName)
        match (message.indexOf(fragment)) {
            case Some(_) => ()
            case None =>
                report.add(
                    caseName + ".message",
                    "a message containing " + itQuote(fragment),
                    itQuote(message)
                )
        }
        itFinish(report)
    }

    @TestCase
    func rejectsAFileThatIsNotAPdf() {
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("garbage")))
        expectFailure("garbage", pdf_get_metadata, arguments)
    }

    @TestCase
    func reportsAnEncryptedDocumentAsNeedingAPassword() {
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("encrypted")))
        expectFailure("encrypted", pdf_get_metadata, arguments)
    }

    @TestCase
    func reportsADamagedPageStreamAsAReadFailure() {
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("corrupt-stream")))
        arguments.add("page", JsonInt(1))
        expectFailure("corrupt-stream", pdf_extract_page, arguments)
    }

    @TestCase
    func rejectsAMissingPath() {
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("does-not-exist")))
        expectFailure("missing-path", pdf_get_metadata, arguments)
    }

    @TestCase
    func rejectsAnOutOfRangePage() {
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("text")))
        arguments.add("page", JsonInt(99))
        expectFailure("page-out-of-range", pdf_extract_page, arguments)
    }

    @TestCase
    func rejectsAnInvertedPageRange() {
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("text")))
        arguments.add("first_page", JsonInt(2))
        arguments.add("last_page", JsonInt(1))
        expectFailure("page-range", pdf_export, arguments)
    }

    @TestCase
    func rejectsAnUnknownExportFormat() {
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("text")))
        arguments.add("format", JsonString("xml"))
        expectFailure("format", pdf_export, arguments)
    }

    @TestCase
    func requiresAPageForThePageScope() {
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("text")))
        arguments.add("scope", JsonString("page"))
        expectFailure("missing-page", pdf_export, arguments)
    }

    @TestCase
    func rejectsAnOutputPathWhoseDirectoryDoesNotExist() {
        let arguments = itArguments()
        arguments.add("path", JsonString(itFixture("text")))
        arguments.add("output_path", JsonString("/nonexistent-pdf-inspector-dir/export.json"))
        expectFailure("output-path", pdf_export, arguments)
    }
}
