private func buildBase14Metrics(): HashMap<String, Base14Metrics> {
    let table = HashMap<String, Base14Metrics>()
    table["Courier"] = Base14Metrics(
        "Courier",
        32,
        COURIER_WIDTHS,
        0.627,
        -0.194
    )
    table["Courier-Bold"] = Base14Metrics(
        "Courier-Bold",
        32,
        COURIER_BOLD_WIDTHS,
        0.627,
        -0.194
    )
    table["Courier-Oblique"] = Base14Metrics(
        "Courier-Oblique",
        32,
        COURIER_OBLIQUE_WIDTHS,
        0.627,
        -0.194
    )
    table["Courier-BoldOblique"] = Base14Metrics(
        "Courier-BoldOblique",
        32,
        COURIER_BOLDOBLIQUE_WIDTHS,
        0.627,
        -0.194
    )
    table["Helvetica"] = Base14Metrics(
        "Helvetica",
        32,
        HELVETICA_WIDTHS,
        0.718,
        -0.207
    )
    table["Helvetica-Bold"] = Base14Metrics(
        "Helvetica-Bold",
        32,
        HELVETICA_BOLD_WIDTHS,
        0.718,
        -0.207
    )
    table["Helvetica-Oblique"] = Base14Metrics(
        "Helvetica-Oblique",
        32,
        HELVETICA_OBLIQUE_WIDTHS,
        0.718,
        -0.207
    )
    table["Helvetica-BoldOblique"] = Base14Metrics(
        "Helvetica-BoldOblique",
        32,
        HELVETICA_BOLDOBLIQUE_WIDTHS,
        0.718,
        -0.207
    )
    table["Times-Roman"] = Base14Metrics(
        "Times-Roman",
        32,
        TIMES_ROMAN_WIDTHS,
        0.683,
        -0.217
    )
    table["Times-Bold"] = Base14Metrics(
        "Times-Bold",
        32,
        TIMES_BOLD_WIDTHS,
        0.683,
        -0.217
    )
    table["Times-Italic"] = Base14Metrics(
        "Times-Italic",
        32,
        TIMES_ITALIC_WIDTHS,
        0.683,
        -0.217
    )
    table["Times-BoldItalic"] = Base14Metrics(
        "Times-BoldItalic",
        32,
        TIMES_BOLDITALIC_WIDTHS,
        0.683,
        -0.217
    )
    table["Symbol"] = Base14Metrics(
        "Symbol",
        32,
        SYMBOL_WIDTHS,
        0.0,
        0.0
    )
    table["ZapfDingbats"] = Base14Metrics(
        "ZapfDingbats",
        32,
        ZAPFDINGBATS_WIDTHS,
        0.0,
        0.0
    )
    return table
}

private let BASE_14_METRICS: HashMap<String, Base14Metrics> = buildBase14Metrics()

/** Exact standard-14 name ("Helvetica-Bold") to its metrics; None when unknown. */
public func base14Metrics(name: String): Option<Base14Metrics> {
    return BASE_14_METRICS.get(name)
}

/** True for names carrying a six-character subset tag, e.g. "ABCDEF+Helvetica". */
private func hasSubsetPrefix(name: String): Bool {
    let runes = name.toRuneArray()
    if (runes.size < 7 || runes[6] != r'+') {
        return false
    }
    for (index in 0..6) {
        let rune = runes[index]
        let upper = rune >= r'A' && rune <= r'Z'
        let lower = rune >= r'a' && rune <= r'z'
        if (!upper && !lower) {
            return false
        }
    }
    return true
}

/**
 * Map a common non-standard family name onto a standard-14 name.
 *
 * Arial and ArialMT become Helvetica, TimesNewRoman and Times become
 * Times-Roman, CourierNew becomes Courier, keeping the bold/italic style found in
 * the name: "Arial,BoldItalic", "Arial-BoldItalicMT" and "ArialBI" all become
 * "Helvetica-BoldOblique" (Helvetica has no separate italic face), while
 * "Arial,Bold" becomes "Helvetica-Bold".  Names that are already standard, and
 * names of no known family, are returned unchanged.  A name carrying a subset
 * prefix ("ABCDEF+Helvetica") is returned unchanged as well: removing that
 * prefix is the caller's job, not this function's.
 */
public func normalizeBase14Name(name: String): String {
    let trimmed = name.trimAscii()
    if (trimmed.isEmpty()) {
        return trimmed
    }
    if (BASE_14_METRICS.contains(trimmed) || hasSubsetPrefix(trimmed)) {
        return trimmed
    }
    let lower = trimmed.toAsciiLower()
    let bold = lower.contains("bold")
    let italic = lower.contains("italic") || lower.contains("oblique")
    var family = ""
    if (lower.contains("helvetica") || lower.contains("arial")) {
        family = "Helvetica"
    } else if (lower.contains("times")) {
        family = "Times"
    } else if (lower.contains("courier")) {
        family = "Courier"
    } else if (lower.contains("symbol")) {
        family = "Symbol"
    } else if (lower.contains("dingbat")) {
        family = "ZapfDingbats"
    } else {
        return trimmed
    }
    if (family == "Symbol") {
        return "Symbol"
    }
    if (family == "ZapfDingbats") {
        return "ZapfDingbats"
    }
    if (family == "Times") {
        if (bold && italic) {
            return "Times-BoldItalic"
        }
        if (bold) {
            return "Times-Bold"
        }
        if (italic) {
            return "Times-Italic"
        }
        return "Times-Roman"
    }
    if (bold && italic) {
        return family + "-BoldOblique"
    }
    if (bold) {
        return family + "-Bold"
    }
    if (italic) {
        return family + "-Oblique"
    }
    return family
}
